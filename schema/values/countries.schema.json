{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jdx.jupiter.ar/schema/values/countries.schema.json",
  "$comment": "JDX 1.0. Creado por Agilmind SRL. Condiciones de uso: ver x-jdx-license.",
  "x-jdx-license": { "spdx": "LicenseRef-Agilmind-JDX", "url": "https://github.com/agilmind/jdx/blob/HEAD/LICENSE" },
  "title": "Países ISO 3166-1 (values/countries.json)",
  "type": "object",
  "properties": {
    "list": { "type": "string", "const": "countries" },
    "version": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$" },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/Country" } }
  },
  "required": ["list", "version", "entries"],
  "additionalProperties": false,
  "$defs": {
    "Country": {
      "type": "object",
      "properties": {
        "iso2": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "numeric": { "type": "string", "pattern": "^\\d{3}$" },
        "name": {
          "$comment": "El nombre en los tres idiomas de JDX, como en las listas abiertas.",
          "type": "object",
          "properties": {
            "es": { "type": "string", "minLength": 1 },
            "pt": { "type": "string", "minLength": 1 },
            "en": { "type": "string", "minLength": 1 }
          },
          "required": ["es", "pt", "en"],
          "additionalProperties": false
        }
      },
      "required": ["iso2", "numeric", "name"],
      "additionalProperties": false
    }
  }
}
