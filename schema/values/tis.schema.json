{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jdx.jupiter.ar/schema/values/tis.schema.json",
  "$comment": "JDX 1.0. Creado por Agilmind SRL. Condiciones de uso: ver x-jdx-license.",
  "x-jdx-license": { "spdx": "LicenseRef-Agilmind-JDX", "url": "https://github.com/agilmind/jdx/blob/HEAD/LICENSE" },
  "title": "Territorios TIS (values/tis.json)",
  "type": "object",
  "properties": {
    "list": { "type": "string", "const": "tis" },
    "version": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$" },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/Territory" } }
  },
  "required": ["list", "version", "entries"],
  "additionalProperties": false,
  "$defs": {
    "Territory": {
      "type": "object",
      "properties": {
        "code": { "type": "string", "pattern": "^\\d{4}$" },
        "kind": { "type": "string", "enum": ["country", "group"] },
        "iso2": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "members": {
          "$comment": "Los países del grupo, como ISO 3166-1 alfa-2.",
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Z]{2}$" },
          "minItems": 1,
          "uniqueItems": true
        },
        "validFrom": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "validTo": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      },
      "required": ["code", "kind"],
      "additionalProperties": false,
      "allOf": [
        {
          "$comment": "Un país lleva su alfa-2 y no tiene miembros; un grupo, sus miembros y no tiene alfa-2.",
          "type": "object",
          "if": {
            "type": "object",
            "properties": { "kind": { "type": "string", "const": "country" } },
            "required": ["kind"]
          },
          "then": { "type": "object", "properties": { "iso2": true, "members": { "not": {} } }, "required": ["iso2"] },
          "else": { "type": "object", "properties": { "members": true, "iso2": { "not": {} } }, "required": ["members"] }
        }
      ]
    }
  }
}
